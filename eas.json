{
  "cli": {
    "version": ">= 3.12.0"
  },
  "build": {
    "staging": {
      "distribution": "store",
      "node": "22.17.0",
      "environment": "development",
      "env": {
        "APP_ENV": "staging"
      },
      "android": {
        "ndk": "25.1.8937393",
        "env": {
          "ANDROID_NDK_VERSION": "25.1.8937393",
          "CMAKE_VERSION": "3.18.1"
        }
      }
      
    },
    "production": {
      "node": "22.17.0",
      "environment": "production",
      "android": {
        "ndk": "25.1.8937393",
        "env": {
        "ANDROID_NDK_VERSION": "25.1.8937393",
        "CMAKE_VERSION": "3.18.1"
      }
      },
      "env": {
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "staging": {
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "android": {
        "track": "production"
      }
    }
  }
}
