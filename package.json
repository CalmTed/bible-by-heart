{
  "name": "bible-by-heart",
  "version": "0.0.9",
  "scripts": {
    "dev": "NODE_ENV=local expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit && eslint --ext .ts,.tsx ./src/",
    "lint-fix": "tsc --noEmit && eslint --ext .ts,.tsx ./src/ --fix",
    "test": "jest --coverage",
    "doctor": "npx @react-native-community/cli doctor",
    "expo-doctor": "npx expo-doctor",
    "build-dev": "eas build --profile staging --platform android --auto-submit-with-profile staging --non-interactive",
    "build-prod": "eas build --platform android --profile production"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|@react-navigation|expo(nent)?|expo-modules-core|expo-dev-menu|@expo|react-native-reanimated|react-native-gesture-handler)"
    ]
  },
  "expo.doctor.reactNativeDirectoryCheck.listUnknownPackages": false,
  "dependencies": {
    "d": "^1.0.2",
    "eas-cli": "16.13.0",
    "expo": "^53.0.12",
    "expo-constants": "^17.0.7",
    "expo-dev-client": "^5.0.12",
    "expo-device": "^7.0.2",
    "expo-document-picker": "~13.1.6",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "^7.0.5",
    "expo-localization": "^16.0.1",
    "expo-notifications": "~0.31.3",
    "expo-random": "^14.0.1",
    "expo-router": "^5.1.0",
    "expo-secure-store": "^14.2.3",
    "expo-splash-screen": "~0.30.3",
    "expo-status-bar": "~2.2.3",
    "expo-task-manager": "^13.1.5",
    "global": "^4.4.0",
    "react": "19.0.0",
    "react-native": "0.79.4",
    "react-native-config": "^1.5.5",
    "react-native-fetch-api": "^3.0.0",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "4.11.1",
    "react-native-storage": "^1.0.1",
    "react-native-svg": "15.11.2",
    "react-native-url-polyfill": "^2.0.0",
    "sharp-cli": "^5.1.0",
    "text-encoding": "^0.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/cli": "^15.1.3",
    "@react-native-community/cli-platform-android": "^17.0.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/stack": "^7.1.2",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/utils": "^8.26.0",
    "eslint": "^9.21.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.7",
    "prettier": "^3.6.2",
    "typescript": "^5.8.2"
  },
  "private": true
}
