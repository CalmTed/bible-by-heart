{
  "name": "bible-by-heart",
  "version": "0.1.0",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit && eslint --ext .ts,.tsx ./src/",
    "lint-fix": "tsc --noEmit && eslint --ext .ts,.tsx ./src/ --fix",
    "test": "jest --coverage",
    "doctor": "npx @react-native-community/cli doctor",
    "expo-doctor": "npx expo-doctor",
    "build-dev": "eas build --profile staging --platform android --auto-submit-with-profile staging --non-interactive",
    "build-prod": "eas build --platform android --profile production"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|@react-navigation|expo(nent)?|expo-modules-core|expo-dev-menu|@expo|react-native-reanimated|react-native-gesture-handler)"
    ]
  },
  "expo.doctor.reactNativeDirectoryCheck.listUnknownPackages": false,
  "dependencies": {
    "buffer": "^6.0.3",
    "d": "^1.0.2",
    "eas-cli": "16.13.0",
    "expo": "^54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-random": "^14.0.1",
    "expo-secure-store": "~15.0.8",
    "expo-share-intent": "^5.1.1",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "global": "^4.4.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-config": "^1.5.5",
    "react-native-fetch-api": "^3.0.0",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-storage": "^1.0.1",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "sharp-cli": "^5.1.0",
    "text-encoding": "^0.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/cli": "^15.1.3",
    "@react-native-community/cli-platform-android": "^17.0.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/stack": "^7.1.2",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/utils": "^8.26.0",
    "eslint": "^9.21.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.2"
  },
  "private": true
}
